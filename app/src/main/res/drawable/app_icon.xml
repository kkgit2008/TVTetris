<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <gradient
                android:angle="315"
                android:endColor="#070B14"
                android:startColor="#18233A" />
            <stroke
                android:width="2dp"
                android:color="#334A70" />
        </shape>
    </item>
    <item
        android:bottom="17dp"
        android:left="17dp"
        android:right="17dp"
        android:top="17dp">
        <shape android:shape="rectangle">
            <corners android:radius="5dp" />
            <gradient
                android:angle="45"
                android:endColor="#00A8FF"
                android:startColor="#7BE7FF" />
            <stroke
                android:width="2dp"
                android:color="#C8F7FF" />
        </shape>
    </item>
</layer-list>
